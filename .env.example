# Contact form email delivery (https://resend.com, free plan)
RESEND_API_KEY=
CONTACT_TO=holdings@libereux.com
CONTACT_FROM=Libereux Website <website@libereux.com>

# Local testing only: lets the website check scan local addresses.
# SCAN_ALLOW_PRIVATE=1

# Online booking (docs/BOOKING_SETUP.md). Leave blank to keep the plain request form only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendars checked for busy time, comma separated. "primary" is the holdings@libereux.com calendar.
# Add the second calendar's address after it, for example: primary,someone@gmail.com
BOOKING_BUSY_CALENDARS=primary
