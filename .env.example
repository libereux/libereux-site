# Contact form email delivery (https://resend.com)
RESEND_API_KEY=
CONTACT_TO=holdings@libereux.com
CONTACT_FROM=Libereux Website <website@libereux.com>

# Live website assistant
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5. Use claude-haiku-5-5 for lower cost.
ASSISTANT_MODEL=
# Local testing only: scripted replies without an API key, and allow scanning local addresses.
# ASSISTANT_MOCK=1
# SCAN_ALLOW_PRIVATE=1
